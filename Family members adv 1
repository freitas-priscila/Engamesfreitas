<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Family Advanced 1</title>
    <style>
        :root { --bg: #000; --gold: #ffcc00; --card-bg: #1a1a1a; }
        body { background: var(--bg); color: white; font-family: 'Segoe UI', sans-serif; text-align: center; padding: 20px; margin: 0; }
        h1 { color: var(--gold); text-transform: uppercase; border-bottom: 2px solid var(--gold); display: inline-block; margin-top: 10px; }
        .grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 10px; max-width: 1000px; margin: 20px auto; perspective: 1000px; }
        .card { height: 130px; cursor: pointer; position: relative; transform-style: preserve-3d; transition: transform 0.5s; }
        .card.flipped { transform: rotateY(180deg); }
        .face { position: absolute; width: 100%; height: 100%; backface-visibility: hidden; display: flex; flex-direction: column; align-items: center; justify-content: center; border-radius: 8px; border: 2px solid var(--gold); padding: 5px; box-sizing: border-box; text-align: center; font-weight: bold; }
        .back { background: var(--card-bg); color: var(--gold); font-size: 2rem; }
        .front { background: var(--gold); color: black; transform: rotateY(180deg); font-size: 0.85rem; }
        .emoji { font-size: 1.8rem; margin-bottom: 5px; }
        .controls { margin-top: 30px; }
        .btn { background: var(--gold); color: black; padding: 12px 25px; text-decoration: none; border-radius: 5px; font-weight: bold; display: inline-block; margin: 5px; border: none; cursor: pointer; }
        @media (max-width: 800px) { .grid { grid-template-columns: repeat(4, 1fr); } }
    </style>
</head>
<body>
    <h1>Family Members Advanced 1</h1>
    <p>In-laws & Relatives</p>
    <div class="grid" id="grid"></div>
    <div class="controls">
        <button class="btn" onclick="start()">Reset Game</button>
        <a href="index.html" class="btn">Back to Portal</a>
    </div>

    <script>
        const vocabulary = [
            { en: "Mother-in-law", pt: "Sogra", icon: "💍" },
            { en: "Father-in-law", pt: "Sogro", icon: "👔" },
            { en: "Parents-in-law", pt: "Sogros", icon: "👪" },
            { en: "Brother-in-law", pt: "Cunhado", icon: "🤝" },
            { en: "Sister-in-law", pt: "Cunhada", icon: "👗" },
            { en: "Son-in-law", pt: "Genro", icon: "🤵" },
            { en: "Daughter-in-law", pt: "Nora", icon: "👰" },
            { en: "Siblings-in-law", pt: "Cunhados", icon: "👥" },
            { en: "Nephew", pt: "Sobrinho", icon: "👦" },
            { en: "Niece", pt: "Sobrinha", icon: "👧" },
            { en: "Nephew and Niece", pt: "Sobrinho e Sobrinha", icon: "🧒" },
            { en: "Uncle", pt: "Tio", icon: "👴" },
            { en: "Aunt", pt: "Tia", icon: "👵" },
            { en: "Cousin", pt: "Primo(a)", icon: "🧒" }
        ];

        let flipped = [], lock = false;

        function speak(text, isEn) {
            if (!isEn) return;
            window.speechSynthesis.cancel();
            const msg = new SpeechSynthesisUtterance(text);
            msg.lang = 'en-US';
            window.speechSynthesis.speak(msg);
        }

        function start() {
            const grid = document.getElementById('grid');
            grid.innerHTML = '';
            let cards = [];
            vocabulary.forEach((item, i) => {
                cards.push({ text: item.en, type: 'en', id: i, icon: item.icon });
                cards.push({ text: item.pt, type: 'pt', id: i, icon: item.icon });
            });
            cards.sort(() => Math.random() - 0.5);

            cards.forEach(data => {
                const card = document.createElement('div');
                card.className = 'card';
                card.innerHTML = `<div class="face back">?</div><div class="face front"><span class="emoji">${data.icon}</span>${data.text}</div>`;
                card.onclick = () => {
                    if (lock || card.classList.contains('flipped')) return;
                    card.classList.add('flipped');
                    speak(data.text, data.type === 'en');
                    flipped.push({ el: card, data: data });
                    if (flipped.length === 2) {
                        lock = true;
                        if (flipped[0].data.id === flipped[1].data.id && flipped[0].data.type !== flipped[1].data.type) {
                            flipped = []; lock = false;
                        } else {
                            setTimeout(() => { flipped.forEach(c => c.el.classList.remove('flipped')); flipped = []; lock = false; }, 1000);
                        }
                    }
                };
                grid.appendChild(card);
            });
        }
        start();
    </script>
</body>
</html>
